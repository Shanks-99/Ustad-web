<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
</IfModule>

<IfModule mod_headers.c>
  # Security headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://translate.google.com https://translate.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://translate.googleapis.com; frame-src https://translate.googleapis.com; frame-ancestors 'none';"

  # HTML responses: no-cache so stale pre-renders never get stuck in browsers
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Content-Type "text/html; charset=utf-8"
  </FilesMatch>

  # Hashed JS/CSS assets: long-lived immutable cache (Vite fingerprints filenames)
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images: one year cache
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|gif)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /

# Redirect old percent-encoded school logos folder to new clean path
RewriteRule ^School%20logos/(.*)$ /school-logos/$1 [R=301,L]

# Serve pre-rendered HTML files if they exist as a file
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve pre-rendered HTML files if they exist as a directory
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise fall back to index.html for client-side routing
RewriteRule ^ /index.html [L]
